// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model Utilisateur {
  id            Int         @id @default(autoincrement())
  nom           String
  prenom        String
  pseudo        String      @unique
  email         String      @unique
  role          Role        @default(USER)
  password      String
  type          String
  orientation   String
  age           Int
  consent       Boolean
  localisation  String
  photoUrl      String?
  createdAt     DateTime    @default(now())
  lastLogin     DateTime?
  emailVerified DateTime?
  description   String?
  recherches    Recherche[]
  envies        Envie[]
  coverUrl      String?
  photos        Photo[]
  experience    String?
  rechercheType String?
  sexe          String?
  fumeur        String?
  silhouette    String?
  taille        String?
  origines      String?
  yeux          String?
  cheveux       String?

  // ✅ Relation inverse des articles
  articles Article[]
}

model Article {
  id        String      @id @default(uuid())
  titre     String
  contenu   String
  slug      String      @unique
  auteurId  Int // ✅ Doit correspondre à Utilisateur.id (Int)
  auteur    Utilisateur @relation(fields: [auteurId], references: [id])
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model Recherche {
  id            Int         @id @default(autoincrement())
  label         String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id])
  utilisateurId Int
}

model Envie {
  id            Int         @id @default(autoincrement())
  label         String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id])
  utilisateurId Int
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model Photo {
  id            Int         @id @default(autoincrement())
  url           String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  utilisateurId Int
  createdAt     DateTime    @default(now())
}
