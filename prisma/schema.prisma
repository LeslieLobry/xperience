generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


enum Role {
  USER
  ADMIN
}

enum MessageType {
  TEXTE
  IMAGE
  VIDEO
}

enum DemandeStatut {
  EN_ATTENTE
  ACCEPTEE
  REFUSEE
}

model DemandeAcces {
  id Int @id @default(autoincrement())

  galeriePriveeId Int
  galeriePrivee   GaleriePrivee @relation("DemandeGalerie", fields: [galeriePriveeId], references: [id])


  demandeurId Int
  demandeur   Utilisateur @relation("Demandeur", fields: [demandeurId], references: [id])

  proprietaireId Int // <- le propriétaire de la galerie
  proprietaire   Utilisateur @relation("GalerieProprio", fields: [proprietaireId], references: [id])

  statut    DemandeStatut @default(EN_ATTENTE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([galeriePriveeId, demandeurId])
}

model Utilisateur {
  id              Int             @id @default(autoincrement())
  nom             String
  prenom          String
  pseudo          String          @unique
  email           String          @unique
  role            Role            @default(USER)
  password        String
  type            String
  orientation     String
  age             Int
  consent         Boolean
  localisation    String
  photoUrl        String?
  createdAt       DateTime        @default(now())
  lastLogin       DateTime?
  emailVerified   DateTime?
  description     String?
  experience      String?
  rechercheType   String?
  fumeur          String?
  silhouette      String?
  taille          Int?
  origines        String?
  yeux            String?
  cheveux         String?
  statut          String          @default("en_ligne")
  avisRecus       Avis[]          @relation("AvisCible")
  avisLaisses     Avis[]          @relation("AvisAuteur")
  evenements      Evenement[]     @relation("Participation")
  evenementsCrees Evenement[]     @relation("EvenementCreateur")
  articles        Article[]
  messages        Message[]       @relation("MessageAuteur")
  participants    Participant[]
  messagesGlobaux GlobalMessage[]
  globalChatRead  GlobalChatRead?
  consentCGU      Boolean         @default(false)
  consentCGUDate  DateTime?
  blocagesFaits   Blocage[]       @relation("BlocagesFaits")
  blocagesRecus   Blocage[]       @relation("BlocagesRecus")
  likesEnvoyes    Like[]          @relation("LikesEnvoyes")
  likesRecus      Like[]          @relation("LikesRecus")
  notifications   Notification[]
  demandesFaite   DemandeAcces[]  @relation("Demandeur")
  demandesRecues  DemandeAcces[]  @relation("GalerieProprio")
  galeriePrivee   GaleriePrivee? // relation 1-1
  recherches      Recherche[]
  envies          Envie[]
  photos          Photo[]
}

model GaleriePrivee {
  id            Int         @id @default(autoincrement())
  nom           String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id])
  utilisateurId Int         @unique
  photos        Photo[]
  createdAt     DateTime    @default(now())

  demandesAcces DemandeAcces[] @relation("DemandeGalerie")
}

model Evenement {
  id           Int           @id @default(autoincrement())
  titre        String
  description  String
  date         DateTime
  lieu         String
  type         String
  acces        String
  imageUrl     String?
  heureDebut   String?
  heureFin     String?
  tarifCouple  Float?
  tarifFemme   Float?
  tarifHomme   Float?
  latitude     Float?
  longitude    Float?
  lien         String?
  createur     Utilisateur   @relation("EvenementCreateur", fields: [createurId], references: [id])
  createurId   Int
  participants Utilisateur[] @relation("Participation")
}

model Article {
  id          String         @id @default(cuid())
  slug        String         @unique
  titre       String
  description String?
  contenu     String
  images      ImageArticle[]
  auteurId    Int
  auteur      Utilisateur    @relation(fields: [auteurId], references: [id])
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  vues        Int            @default(0)
}

model ImageArticle {
  id        String  @id @default(cuid())
  url       String
  article   Article @relation(fields: [articleId], references: [id])
  articleId String
}

model Recherche {
  id            Int         @id @default(autoincrement())
  label         String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id])
  utilisateurId Int
}

model Envie {
  id            Int         @id @default(autoincrement())
  label         String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id])
  utilisateurId Int
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model Avis {
  id          Int         @id @default(autoincrement())
  commentaire String
  createdAt   DateTime    @default(now())
  auteurId    Int
  cibleId     Int
  auteur      Utilisateur @relation("AvisAuteur", fields: [auteurId], references: [id])
  cible       Utilisateur @relation("AvisCible", fields: [cibleId], references: [id])

  @@unique([auteurId, cibleId])
}

model Conversation {
  id           Int           @id @default(autoincrement())
  participants Participant[]
  messages     Message[]
  updatedAt    DateTime      @updatedAt
  createdAt    DateTime      @default(now())
}

model Participant {
  id             Int @id @default(autoincrement())
  utilisateurId  Int
  conversationId Int

  utilisateur  Utilisateur  @relation(fields: [utilisateurId], references: [id])
  conversation Conversation @relation(fields: [conversationId], references: [id])

  lastReadAt DateTime? // Date à laquelle l’utilisateur a lu cette conversation
  supprimé  Boolean   @default(false)

  @@unique([utilisateurId, conversationId])
}

model Message {
  id             Int         @id @default(autoincrement())
  conversationId Int
  auteurId       Int
  contenu        String?
  imageUrl       String?
  videoUrl       String?
  type           MessageType @default(TEXTE)
  lu             Boolean     @default(false)
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id])
  auteur       Utilisateur  @relation("MessageAuteur", fields: [auteurId], references: [id])
}

model Photo {
  id              Int            @id @default(autoincrement())
  url             String
  utilisateur     Utilisateur    @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  utilisateurId   Int
  galeriePrivee   GaleriePrivee? @relation(fields: [galeriePriveeId], references: [id])
  galeriePriveeId Int?
  createdAt       DateTime       @default(now())
}

model GlobalMessage {
  id        Int      @id @default(autoincrement())
  auteurId  Int
  contenu   String
  createdAt DateTime @default(now())

  auteur Utilisateur @relation(fields: [auteurId], references: [id])
}

model GlobalChatRead {
  id       Int         @id @default(autoincrement())
  userId   Int         @unique
  lastRead DateTime
  user     Utilisateur @relation(fields: [userId], references: [id])
}

model Blocage {
  id         Int         @id @default(autoincrement())
  bloqueur   Utilisateur @relation("BlocagesFaits", fields: [bloqueurId], references: [id])
  bloqueurId Int
  bloque     Utilisateur @relation("BlocagesRecus", fields: [bloquéId], references: [id])
  bloquéId  Int
  createdAt  DateTime    @default(now())

  @@unique([bloqueurId, bloquéId])
}

model Like {
  id        Int         @id @default(autoincrement())
  auteurId  Int
  cibleId   Int
  createdAt DateTime    @default(now())
  auteur    Utilisateur @relation("LikesEnvoyes", fields: [auteurId], references: [id])
  cible     Utilisateur @relation("LikesRecus", fields: [cibleId], references: [id])

  @@unique([auteurId, cibleId]) // un seul like possible par paire
}

model Notification {
  id            Int      @id @default(autoincrement())
  utilisateurId Int
  message       String
  lien          String? // par ex. lien vers profil ou message
  lu            Boolean  @default(false)
  createdAt     DateTime @default(now())

  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id])
}
