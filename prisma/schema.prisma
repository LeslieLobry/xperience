generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model Utilisateur {
  id              Int         @id @default(autoincrement())
  nom             String
  prenom          String
  pseudo          String      @unique
  email           String      @unique
  role            Role        @default(USER)
  password        String
  type            String
  orientation     String
  age             Int
  consent         Boolean
  localisation    String
  photoUrl        String?
  createdAt       DateTime    @default(now())
  lastLogin       DateTime?
  emailVerified   DateTime?
  description     String?
  recherches      Recherche[]
  envies          Envie[]
  coverUrl        String?
  photos          Photo[]
  experience      String?
  rechercheType   String?
  sexe            String?
  fumeur          String?
  silhouette      String?
  taille          String?
  origines        String?
  yeux            String?
  cheveux         String?
  statut          String      @default("hors_ligne") // "en_ligne" ou "hors_ligne"
  avisRecus       Avis[]      @relation("AvisCible")
  avisLaisses     Avis[]      @relation("AvisAuteur")
  evenements      Evenement[] @relation("Participation") // ✅ correction ici
  articles        Article[]
  evenementsCrees Evenement[] @relation("EvenementCreateur")
}

model Evenement {
  id           Int           @id @default(autoincrement())
  titre        String
  description  String
  date         DateTime
  heureDebut   String?
  heureFin     String?
  lieu         String
  type         String?
  acces        String?
  imageUrl     String?
  tarifCouple  Float?
  tarifFemme   Float?
  tarifHomme   Float?
  createur     Utilisateur   @relation("EvenementCreateur", fields: [createurId], references: [id])
  createurId   Int
  participants Utilisateur[] @relation("Participation") // ✅ relation cohérente
}

model Article {
  id          String         @id @default(cuid())
  slug        String         @unique
  titre       String
  description String?
  contenu     String
  images      ImageArticle[]
  auteurId    Int
  auteur      Utilisateur    @relation(fields: [auteurId], references: [id])
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model ImageArticle {
  id        String  @id @default(cuid())
  url       String
  article   Article @relation(fields: [articleId], references: [id])
  articleId String
}

model Recherche {
  id            Int         @id @default(autoincrement())
  label         String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id])
  utilisateurId Int
}

model Envie {
  id            Int         @id @default(autoincrement())
  label         String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id])
  utilisateurId Int
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model Photo {
  id            Int         @id @default(autoincrement())
  url           String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  utilisateurId Int
  createdAt     DateTime    @default(now())
}

model Avis {
  id          Int         @id @default(autoincrement())
  commentaire String
  createdAt   DateTime    @default(now())
  auteurId    Int
  cibleId     Int
  auteur      Utilisateur @relation("AvisAuteur", fields: [auteurId], references: [id])
  cible       Utilisateur @relation("AvisCible", fields: [cibleId], references: [id])

  @@unique([auteurId, cibleId])
}
