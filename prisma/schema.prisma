generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model DemandeAcces {
  id              Int           @id @default(autoincrement())
  galeriePriveeId Int
  demandeurId     Int
  proprietaireId  Int
  statut          DemandeStatut @default(EN_ATTENTE)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  demandeur       Utilisateur   @relation("Demandeur", fields: [demandeurId], references: [id])
  galeriePrivee   GaleriePrivee @relation("DemandeGalerie", fields: [galeriePriveeId], references: [id])
  proprietaire    Utilisateur   @relation("GalerieProprio", fields: [proprietaireId], references: [id])

  @@unique([galeriePriveeId, demandeurId])
}
model Utilisateur {
  id                   Int             @id @default(autoincrement())
  nom                  String
  prenom               String
  pseudo               String          @unique
  email                String          @unique
  role                 Role            @default(USER)
  password             String
  type                 String
  orientation          String
  age                  Int
  consent              Boolean
  localisation         String
  latitude             Float?
  longitude            Float?
  photoUrl             String?
  createdAt            DateTime        @default(now())
  lastLogin            DateTime?
  emailVerified        DateTime?
  description          String?
  experience           String?
  rechercheType        String?
  fumeur               String?
  silhouette           String?
  taille               Int?
  origines             String?
  yeux                 String?
  cheveux              String?
  reactions MessageReaction[]
  profilComplet Boolean @default(false) @map("profil_complet")
  reminderSent  Boolean @default(false) @map("reminder_sent")
  

  // ✅ Champs supplémentaires pour les couples

  age2                 Int?
  dateNaissance2       DateTime?
  fumeur2              String?
  silhouette2          String?
  taille2              Int?
  origines2            String?
  yeux2                String?
  cheveux2             String?
  description2         String?
  statut               String          @default("en_ligne")
  statutAuto Boolean @default(true) 
  consentCGU           Boolean         @default(false)
  consentCGUDate       DateTime?
  verificationDeadline DateTime?
  verificationIdentite Boolean         @default(false)

  articles             Article[]
  avisLaisses          Avis[]          @relation("AvisAuteur")
  avisRecus            Avis[]          @relation("AvisCible")
  blocagesFaits        Blocage[]       @relation("BlocagesFaits")
  blocagesRecus        Blocage[]       @relation("BlocagesRecus")
  demandesFaite        DemandeAcces[]  @relation("Demandeur")
  demandesRecues       DemandeAcces[]  @relation("GalerieProprio")
  envies               Envie[]
  evenementsCrees      Evenement[]     @relation("EvenementCreateur")
  galeriePrivee        GaleriePrivee?
  globalChatRead       GlobalChatRead?
  messagesGlobaux      GlobalMessage[]
  likesEnvoyes         Like[]          @relation("LikesEnvoyes")
  likesRecus           Like[]          @relation("LikesRecus")
  messages             Message[]       @relation("MessageAuteur")
  notifications        Notification[]
  participants         Participant[]
  photos               Photo[]
  recherches           Recherche[]
  evenements           Evenement[]     @relation("Participation")
  visitesFaites     VisiteProfil[] @relation("Visiteur")
  visitesRecues     VisiteProfil[] @relation("Visite")
  prenomsCouple PrenomCoupleConversation[] 

  @@map("Utilisateur")
}

model GaleriePrivee {
  id            Int            @id @default(autoincrement())
  nom           String
  utilisateurId Int            @unique
  createdAt     DateTime       @default(now())
  demandesAcces DemandeAcces[] @relation("DemandeGalerie")
  utilisateur   Utilisateur    @relation(fields: [utilisateurId], references: [id])
  photos        Photo[]
  @@map("GaleriePrivee")
}
model Evenement {
  id           Int           @id @default(autoincrement())
  titre        String
  description  String
  dates        DateTime[]    // 👈 Ici, plus de "date" simple
  lieu         String
  type         String
  acces        String
  imageUrl     String?
  heureDebut   String?
  heureFin     String?
  tarifCouple  Float?
  tarifFemme   Float?
  tarifHomme   Float?
  latitude     Float?
  longitude    Float?
  lien         String?

  createurId   Int
  createur     Utilisateur   @relation("EvenementCreateur", fields: [createurId], references: [id])
  participants Utilisateur[] @relation("Participation")
  @@map("Evenement")
}

model Article {
  id          String         @id @default(cuid())
  slug        String         @unique
  titre       String
  description String?
  contenu     String
  auteurId    Int
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  vues        Int            @default(0)
  auteur      Utilisateur    @relation(fields: [auteurId], references: [id])
  images      ImageArticle[]
  @@map("Article")
}

model ImageArticle {
  id        String  @id @default(cuid())
  url       String
  articleId String
  article   Article @relation(fields: [articleId], references: [id])
  @@map("ImageArticle")
}

model Recherche {
  id            Int         @id @default(autoincrement())
  label         String
  utilisateurId Int
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id])
  @@map("Recherche")
}

model Envie {
  id            Int         @id @default(autoincrement())
  label         String
  utilisateurId Int
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id])
    @@map("Envie")
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
    @@map("EmailVerificationToken")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
    @@map("PasswordResetToken")
}

model Avis {
  id          Int         @id @default(autoincrement())
  commentaire String
  createdAt   DateTime    @default(now())
  auteurId    Int
  cibleId     Int
  auteur      Utilisateur @relation("AvisAuteur", fields: [auteurId], references: [id])
  cible       Utilisateur @relation("AvisCible", fields: [cibleId], references: [id])
    @@map("Avis")

  @@unique([auteurId, cibleId])
}

model Conversation {
  id           Int           @id @default(autoincrement())
  updatedAt    DateTime      @updatedAt
  createdAt    DateTime      @default(now())
  messages     Message[]
  participants Participant[]
   prenomsCouple PrenomCoupleConversation[] 
    @@map("Conversation")
}

model Participant {
  id             Int          @id @default(autoincrement())
  utilisateurId  Int
  conversationId Int
  lastReadAt     DateTime?
  supprimé      Boolean      @default(false)
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  utilisateur    Utilisateur  @relation(fields: [utilisateurId], references: [id])

  @@unique([utilisateurId, conversationId])
    @@map("Participant")
}

model Message {
  id             Int          @id @default(autoincrement())
  conversationId Int
  auteurId       Int
  contenu        String?
  imageUrl       String?
  videoUrl       String?
  audioUrl       String?       // 🔊 Ajout audio
  duree          String?       // ⏱️ Ajout durée (ex: "0:21")
  type           MessageType  @default(TEXTE)
  lu             Boolean      @default(false)
  createdAt      DateTime     @default(now())
  auteur         Utilisateur  @relation("MessageAuteur", fields: [auteurId], references: [id])
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  reactions MessageReaction[] 
  envoyeur       String?
  prenomEnvoyeur String?
  @@index([conversationId, id])
  @@map("Message")
}


model Photo {
  id              Int            @id @default(autoincrement())
  url             String
  utilisateurId   Int
  galeriePriveeId Int?
  createdAt       DateTime       @default(now())
  galeriePrivee   GaleriePrivee? @relation(fields: [galeriePriveeId], references: [id])
  utilisateur     Utilisateur    @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
    @@map("Photo")
}

model GlobalMessage {
  id        Int         @id @default(autoincrement())
  auteurId  Int
  contenu   String
  createdAt DateTime    @default(now())
  auteur    Utilisateur @relation(fields: [auteurId], references: [id])
    @@map("GlobalMessage")
}

model GlobalChatRead {
  id       Int         @id @default(autoincrement())
  userId   Int         @unique
  lastRead DateTime
  user     Utilisateur @relation(fields: [userId], references: [id])
    @@map("GlobalChatRead")
}

model Blocage {
  id         Int         @id @default(autoincrement())
  bloqueurId Int
  bloquéId  Int
  createdAt  DateTime    @default(now())
  bloqueur   Utilisateur @relation("BlocagesFaits", fields: [bloqueurId], references: [id])
  bloque     Utilisateur @relation("BlocagesRecus", fields: [bloquéId], references: [id])

  @@unique([bloqueurId, bloquéId])
    @@map("Blocage")
}

model Like {
  id        Int         @id @default(autoincrement())
  auteurId  Int
  cibleId   Int
  createdAt DateTime    @default(now())
  auteur    Utilisateur @relation("LikesEnvoyes", fields: [auteurId], references: [id])
  cible     Utilisateur @relation("LikesRecus", fields: [cibleId], references: [id])

  @@unique([auteurId, cibleId])
    @@map("Like")
}

model Notification {
  id            Int         @id @default(autoincrement())
  utilisateurId Int
  message       String
  lien          String?
  lu            Boolean     @default(false)
  createdAt     DateTime    @default(now())
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id])
    @@map("Notification")
}

model AbonneNewsletter {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  createdAt DateTime @default(now())
    @@map("AbonneNewsletterRecherche")
}

model Newsletter {
  id        Int      @id @default(autoincrement())
  titre     String
  contenu   String
  createdAt DateTime @default(now())
    @@map("Newsletter")
}
model VisiteProfil {
  id         Int         @id @default(autoincrement())
  visiteurId Int
  visiteId   Int
  date       DateTime    @default(now())

  visiteur   Utilisateur @relation("Visiteur", fields: [visiteurId], references: [id])
  visite     Utilisateur @relation("Visite", fields: [visiteId], references: [id])

  @@unique([visiteurId, visiteId, date])
  @@map("VisiteProfil")
}
model MessageReaction {
  id            Int         @id @default(autoincrement())
  emoji         String      // Exemple : "❤️" ou "😂"
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id])
  utilisateurId Int
  message       Message     @relation(fields: [messageId], references: [id])
  messageId     Int
  createdAt     DateTime    @default(now())

  @@unique([utilisateurId, messageId]) // un utilisateur ne peut réagir qu'une seule fois par message
  @@index([messageId])  
}



enum Role {
  USER
  ADMIN
}

enum MessageType {
  TEXTE
  IMAGE
  VIDEO
  AUDIO
}

enum DemandeStatut {
  EN_ATTENTE
  ACCEPTEE
  REFUSEE
}
model Partenaire {
  id        String   @id @default(dbgenerated()) @db.Uuid
  nom       String
  type      String
  lien      String
  photoUrl  String?  
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@map("Partenaire")
}
model PrenomCoupleConversation {
  id             Int    @id @default(autoincrement())
  conversationId Int    @map("conversationid")
  utilisateurId  Int    @map("utilisateurid")
  prenom1        String
  prenom2        String

  conversation   Conversation @relation(fields: [conversationId], references: [id])
  utilisateur    Utilisateur  @relation(fields: [utilisateurId], references: [id])

  @@unique([conversationId, utilisateurId])
  @@map("PrenomCoupleConversation")  // 👈 important !
}

