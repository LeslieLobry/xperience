{
  "functions": {
    "api/cron/**": {
      "runtime": "nodejs20.x",
      "regions": ["cdg1", "fra1", "arn1"]
    },
    "app/api/**/route.{js,ts}": {
      "runtime": "edge",
      "regions": ["cdg1", "fra1", "arn1"]
    },
    "api/**": {
      "runtime": "nodejs20.x",
      "regions": ["cdg1", "fra1", "arn1"]
    }
  },
  "crons": [
    {
      "path": "/api/cron/reminder-profile?token=@CRON_SECRET",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/send-digests?token=@CRON_SECRET",
      "schedule": "0 9 * * *"
    }
  ]
}
